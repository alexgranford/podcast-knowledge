# podcast-knowledge settings. Outside Hermes: copy to .env (git-ignored; chmod 600) or set them in the
# environment; a variable already set in the environment wins over this file. Under Hermes: put them in
# Hermes's own .env (~/.hermes/.env, in Docker /opt/data/.env) and keep no .env here.

# --- local models (oMLX: https://github.com/jundot/omlx) ---------------------------------------------
OMLX_BASE_URL=http://127.0.0.1:8000
OMLX_API_KEY=
OMLX_ASR_MODEL=Qwen3-ASR-1.7B-8bit
PODNOTE_MODEL=gemma-4-26B-A4B-it-qat-4bit
# Optional: write notes with any OpenAI-compatible service instead of local oMLX (speech still uses oMLX)
# PODNOTE_BASE_URL=https://openrouter.ai/api/v1
# PODNOTE_API_KEY=

# --- where things live ----------------------------------------------------------------------------
PODNOTE_ROOT=/path/to/your/notes               # any local folder; an Obsidian vault works well
PODNOTE_NOTES_DIR=Podcasts                     # inside PODNOTE_ROOT: one folder per show
PODNOTE_CACHE=/var/tmp/podnote                 # audio, transcripts, model output per episode
PODNOTE_STATE=/var/tmp/podnote-state           # queue, show registry, logs
PODNOTE_VAD_RUNTIME=/var/lib/podnote/vad-runtime   # the speech-detection venv (see README)

# --- web search (optional; without it the validation pass does less) ----------------------------------
PODNOTE_BRAVE_API_KEY=                         # web search: evidence for claims, names of cited books
PODNOTE_CONTACT=                               # your e-mail or URL, sent to Wikipedia & co. as asked of bots

# --- your notes folder's conventions (optional) -----------------------------------------------------
PODNOTE_SCRIPT_TAG=                            # the tag your folder gives notes written by scripts
# PODNOTE_TEST_RULES=/path/to/notes/_meta      # run the tests against your folder's own metadata standard
